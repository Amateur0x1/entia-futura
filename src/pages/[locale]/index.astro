---
import HomeEffects from '../../components/home/HomeEffects.astro';
import HomeFourthPanel from '../../components/home/HomeFourthPanel.astro';
import HomeHeroScreen from '../../components/home/HomeHeroScreen.astro';
import HomeSecondPanel from '../../components/home/HomeSecondPanel.astro';
import HomeThirdPanel from '../../components/home/HomeThirdPanel.astro';
import PageLoader from '../../components/home/PageLoader.astro';
import Layout from '../../layouts/Layout.astro';
import { siteMeta } from '../../content/site';
import { isLocale, pickByLocale, toLocalePath } from '../../i18n/config';

const { locale } = Astro.params;

if (!isLocale(locale)) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const currentPath = Astro.url.pathname;
const zhLocalePath = toLocalePath('zh', currentPath);
const enLocalePath = toLocalePath('en', currentPath);
const localeDropdownLabel = pickByLocale(locale, '选择语言', 'Choose language');

const pageTitle = pickByLocale(locale, siteMeta.zhName, siteMeta.enName);
const pageDescription = pickByLocale(
  locale,
  '一个以轨道档案为视觉母题的研究所首页：问题被重新编目，研究通过横向转译链进入现实。',
  'An institute homepage built around an orbital archive: questions are re-indexed and research enters reality through a horizontal chain of translation.',
);
// ── Second panel: Mission & Vision ──────────────────────────────────────────
const coreQuestion = pickByLocale(locale, '使命、愿景与价值观', 'Mission, Vision & Values');
const instituteIntro = pickByLocale(
  locale,
  '使命：围绕"未来我们将如何存在？"这一核心问题，连接研究、社群、产业与现实实验。\n愿景：在大学之外，建立一种更开放、更现实、也更具协作能力的新型研究机构。',
  'Mission: To organize research, community, industry, and real-world experimentation around one central question: How shall we exist in the future?\nVision: To build a new kind of institute beyond the university — more open, more grounded, and more capable of collaboration.',
);

const whatWeDoTitle = pickByLocale(locale, '我们做什么？', 'What We Do?');
const whatWeDoIntro = pickByLocale(
  locale,
  '我们关心的不只是技术将如何改变世界，更关心在技术剧变与社会重组的时代，我们将如何学习、工作、居住、连接、创造，并重新组织知识、空间与共同体。',
  'We are concerned not only with how technology is changing the world, but with how, in a time of technological transformation and social reconfiguration, we shall learn, work, dwell, connect, create, and reorganize knowledge, space, and collective life.',
);
const whatWeDoModules = [
  {
    zhTitle: '研究',
    enTitle: 'Research',
    zhBody: '围绕未来社会的重要议题展开长期研究、写作、访谈、观察、案例档案与公共讨论。',
    enBody:
      'Long-term inquiry, writing, interviews, observation, case archives, and public discussion around critical questions of future society.',
  },
  {
    zhTitle: '项目机制',
    enTitle: 'Programs',
    zhBody: '通过研究项目、公共活动、协作项目、驻留机制、社群结构与实验项目组织工作。',
    enBody:
      'Work organized through research programs, public programs, collaborative projects, residencies, community structures, and experimental initiatives.',
  },
  {
    zhTitle: '研究转化',
    enTitle: 'Research in Practice',
    zhBody: '让高等研究进入现实问题、组织实践、品牌叙事、空间场景与协作机制之中。',
    enBody:
      'Bringing advanced inquiry into real-world questions, organizational practice, narrative work, spaces, and collaborative structures.',
  },
  {
    zhTitle: '未来项目',
    enTitle: 'Future Ventures',
    zhBody: '从研究中发展项目、机制、原型与新的组织形式，测试未来社会的可能结构。',
    enBody:
      'Developing projects, mechanisms, prototypes, and new institutional forms out of inquiry to test possible futures.',
  },
] as const;
---

<Layout title={`${pageTitle} | ${siteMeta.enName}`} description={pageDescription} locale={locale} theme="landing-dark">
  <PageLoader />
  <main class="landing-main" data-hero-stage>
    <HomeHeroScreen locale={locale} />
    <HomeSecondPanel locale={locale} coreQuestion={coreQuestion} instituteIntro={instituteIntro} />
    <div class="landing-scroll-spacer" data-landing-scroll-spacer aria-hidden="true"></div>
    <HomeThirdPanel
      locale={locale}
      title={whatWeDoTitle}
      intro={whatWeDoIntro}
      modules={whatWeDoModules}
    />
    <!-- Additional scroll spacer for panel 4 -->
    <div class="landing-scroll-spacer-extra" data-landing-scroll-spacer-4 aria-hidden="true"></div>
    <HomeFourthPanel locale={locale} />
  </main>
  <section class="landing-system" data-hero-stage>
    <div class="floating-brand-cluster" data-brand-cluster>
      <!-- Logo buttons intentionally avoid sheen classes; motion is GSAP-only for now. -->
      <a
        class="floating-base-button floating-nameplate-button"
        data-brand-logo-button
        data-brand-cluster-button
        href={toLocalePath(locale, '/')}
      >
        <span data-brand-animated-text>Entia Futura /</span>
        {locale === 'zh' ? (
          <small data-brand-animated-text>未来人研究所</small>
        ) : (
          <small class="floating-nameplate-line-en" data-brand-animated-text>
            Institute for future beings
          </small>
        )}
      </a>
    </div>
    <div class="floating-top-actions">
      <a class="floating-base-button floating-button floating-contact-button" data-brand-contact-button href={toLocalePath(locale, '/contact')}>
        <i class="floating-more-fill" data-contact-fill aria-hidden="true"></i>
        <span style="transform: translateY(-0.5px)">Contact</span>
      </a>
      <div class="floating-locale-dropdown" data-locale-dropdown>
        <button
          type="button"
          class="floating-base-button floating-button floating-contact-button floating-locale-button"
          data-locale-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="floating-locale-menu"
          aria-label={localeDropdownLabel}
        >
          <i class="floating-more-fill" data-locale-fill aria-hidden="true"></i>
          <div class="floating-locale-trigger-icons">
            <svg class="floating-locale-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M3 12h18" fill="none" stroke="currentColor" stroke-width="1.5"></path>
              <path
                d="M12 3c2.8 3.4 4.5 7.2 4.5 9s-1.7 5.6-4.5 9M12 3c-2.8 3.4-4.5 7.2-4.5 9s1.7 5.6-4.5 9"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"></path>
            </svg>
            <svg class="floating-locale-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 16.2 5.8 10l1.4-1.4L12 13.4l4.8-4.8 1.4 1.4z" fill="currentColor"></path>
            </svg>
          </div>
        </button>
        <div class="floating-locale-popover">
          <ul class="floating-locale-menu" id="floating-locale-menu" role="listbox" aria-label={localeDropdownLabel}>
            <li role="presentation">
              {locale === 'zh' ? (
                <span class="floating-locale-option floating-locale-option--current" role="option" aria-selected="true">
                  中文
                </span>
              ) : (
                <a class="floating-locale-option" role="option" href={zhLocalePath}>
                  中文
                </a>
              )}
            </li>
            <li role="presentation">
              {locale === 'en' ? (
                <span class="floating-locale-option floating-locale-option--current" role="option" aria-selected="true">
                  英语
                </span>
              ) : (
                <a class="floating-locale-option" role="option" href={enLocalePath}>
                  英语
                </a>
              )}
            </li>
          </ul>
        </div>
      </div>
    </div>
    <button class="floating-know-more-button" data-know-more-button type="button" aria-label={locale === 'en' ? 'Know more' : '了解更多'}>
      <span>{locale === 'en' ? 'KNOW MORE' : '了解更多'}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 16.2 5.8 10l1.4-1.4L12 13.4l4.8-4.8 1.4 1.4z"></path>
      </svg>
    </button>
    <!-- Second panel Know More — same pill style, shown after second panel text reveal -->
    <button
      class="floating-know-more-button second-panel-know-more"
      data-second-panel-know-more
      type="button"
      aria-label={locale === 'en' ? 'Know more' : '了解更多'}
    >
      <span>{locale === 'en' ? 'KNOW MORE' : '了解更多'}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 16.2 5.8 10l1.4-1.4L12 13.4l4.8-4.8 1.4 1.4z"></path>
      </svg>
    </button>
  </section>
  <HomeEffects />
</Layout>

<style>
  :global(body.theme-landing-dark .page-shell-landing) {
    padding: 0;
  }

  [data-hero-stage] {
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-hero-stage].is-revealed {
    opacity: 1;
  }

  .landing-scroll-spacer {
    height: 380svh;
    width: 100%;
    pointer-events: none;
  }

  /* Spacer for panel 4 — height calibrated by GSAP at runtime (buildPushTimeline).
     Set an initial floor that covers PUSH_DURATION(1.6) + buffer(0.4) + extra = 280svh
     so layout is never under-estimated before JS runs. */
  .landing-scroll-spacer-extra {
    height: 280svh;
    width: 100%;
    pointer-events: none;
  }

  /* Second-panel Know More button: same pill as screen 1 but sits above
     second panel (z-index 31), hidden until JS adds .is-visible */
  :global(.second-panel-know-more) {
    z-index: 31;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  :global(.second-panel-know-more.is-visible) {
    opacity: 1;
    pointer-events: auto;
  }

  /* Panel 4: initial state — GSAP scrub timeline owns all visual properties.
     No CSS transition here; transitions would fight the scrub and cause jumps. */
  :global([data-fourth-panel]) {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .landing-scroll-spacer {
      height: 320svh;
    }

    .landing-scroll-spacer-extra {
      height: 220svh;
    }
  }
</style>
