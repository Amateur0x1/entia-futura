---
import './landing-hero/landingHero.css';
import { siteMeta } from '../../content/site';
import type { Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { assetsUrl } = siteMeta;
const { locale } = Astro.props;
const isZh = locale !== 'en';
---

<section class="hero-transition-stage" data-hero-transition-root>
  <div class="hero-transition-frame" data-orbit-frame>
    <div class="hero-video-shell" data-hero-video-shell>
      <div class="hero-video-loading" data-hero-video-loading aria-hidden="true"></div>
      <video
        class="hero-video hero-video-scroll"
        data-scroll-video
        src={`${assetsUrl}/root/portal-scroll.mp4`}
        crossorigin="anonymous"
        muted
        playsinline
        webkit-playsinline
        preload="auto"
      ></video>
      <video
        class="hero-video hero-video-loop"
        data-loop-video
        src="/videos/portal-loop.webm"
        crossorigin="anonymous"
        autoplay
        loop
        muted
        playsinline
        webkit-playsinline
        preload="auto"
      ></video>
      <div class="hero-video-overlay" aria-hidden="true"></div>
      <div class="hero-video-vignette" aria-hidden="true"></div>
    </div>

    <!-- Institute Overview overlay — revealed after scroll-video ends, during loop-video hold -->
    <div class="hero-institute-overview" data-institute-overview aria-hidden="true">
      <div class="hero-institute-overview__inner">
        <div class="hero-institute-overview__header">
          <span class="hero-institute-overview__label">{isZh ? '机构概览' : 'Institute Overview'}</span>
        </div>
        <div class="hero-institute-overview__divider" data-overview-divider></div>
        <div class="hero-institute-overview__content">
          <div class="hero-institute-overview__void" aria-hidden="true"></div>
          {isZh ? (
            <>
              <p class="hero-institute-overview__line" data-overview-line>
                未来人研究所（ENTIA FUTURA INSTITUT）是一个围绕"未来我们将如何存在？"这一核心问题展开工作的独立研究机构。它既不是传统学院，也不是普通咨询公司、内容平台或松散社群，而是试图在大学之外，建立一种新的研究所形态。
              </p>
              <p class="hero-institute-overview__line hero-institute-overview__line--secondary" data-overview-line>
                我们以高等研究为基础，同时强调研究向现实问题、合作机制与未来项目的持续转化。研究不应只停留在论文与观点层面，而应进入组织实践、空间场景、地方协作、社群机制与社会实验之中。
              </p>
            </>
          ) : (
            <>
              <p class="hero-institute-overview__line" data-overview-line>
                Entia Futura Institut is an independent institute organized around one core question: How shall we exist in the future? It is neither a conventional academic department nor a consulting firm, media platform, or loose social community, but an attempt to build a new institutional form beyond the university.
              </p>
              <p class="hero-institute-overview__line hero-institute-overview__line--secondary" data-overview-line>
                Grounded in advanced research, the institute is equally committed to translating inquiry into real-world problems, collaborative structures, future-oriented projects, and social experimentation.
              </p>
            </>
          )}
          <blockquote class="hero-institute-overview__quote" data-overview-quote>
            {isZh ? (
              <span class="hero-institute-overview__quote-text">研究不是现实的旁观者，而应成为现实中的形成力。</span>
            ) : (
              <span class="hero-institute-overview__quote-text">Inquiry should not remain a spectator of reality; it should become a formative force within it.</span>
            )}
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initLandingHeroInteractions } from './landing-hero/landingHeroInteractions';

  initLandingHeroInteractions();

  // Watch video.buffered and drive loader progress with real download percentage.
  // Dispatches:
  //   scrollvideo:bufferupdate  { detail: { pct: number } }  — every 200ms while loading
  //   scrollvideo:bufferready                                 — when buffered >= READY_THRESHOLD
    const scrollVideo = document.querySelector<HTMLVideoElement>('[data-scroll-video]');
  if (scrollVideo) {
    let readyDispatched = false;

    // How much of the video must be buffered before we consider it "ready".
    const READY_THRESHOLD = 0.95;

    const getBufferedPct = (): number => {
      const buf = scrollVideo.buffered;
      const dur = scrollVideo.duration;
      if (!dur || !isFinite(dur) || buf.length === 0) return 0;
      return buf.end(buf.length - 1) / dur;
    };

    const dispatchReady = () => {
      if (readyDispatched) return;
      readyDispatched = true;
      document.dispatchEvent(new CustomEvent('scrollvideo:bufferupdate', { detail: { pct: 1 } }));
      document.dispatchEvent(new CustomEvent('scrollvideo:bufferready'));
    };

    // Poll buffered progress and update loader bar every 200ms.
    const checkBuffer = () => {
      const pct = getBufferedPct();
      document.dispatchEvent(new CustomEvent('scrollvideo:bufferupdate', { detail: { pct } }));
      if (!readyDispatched) setTimeout(checkBuffer, 200);
    };

    // Fire ready as soon as the buffered threshold is reached.
    scrollVideo.addEventListener('canplaythrough', () => {
      const pct = getBufferedPct();
      if (pct >= READY_THRESHOLD) {
        dispatchReady();
      }
    }, { once: true });

    const startPolling = () => {
      checkBuffer();
      // Also watch for the progress event to catch buffered updates.
      scrollVideo.addEventListener('progress', () => {
        const pct = getBufferedPct();
        document.dispatchEvent(new CustomEvent('scrollvideo:bufferupdate', { detail: { pct } }));
        if (!readyDispatched && pct >= READY_THRESHOLD) dispatchReady();
      });
    };

    // If video errors out, skip the buffer gate immediately.
    // Also handle the case where error already fired before this script ran.
    if (scrollVideo.error) {
      dispatchReady();
    } else {
      scrollVideo.addEventListener('error', () => dispatchReady(), { once: true });
    }

    if (scrollVideo.readyState >= 1) {
      startPolling();
    } else {
      scrollVideo.addEventListener('loadedmetadata', startPolling, { once: true });
    }
  }
</script>
