---
import type { Locale } from '../../i18n/config';
import HomeMonolithVisual from './HomeMonolithVisual.astro';

interface Props {
  locale: Locale;
  label: string;
  /** Paragraphs separated by '\n'. First is primary, the rest secondary. */
  body: string;
}

const { locale, label, body } = Astro.props;
const lines = body.split('\n').filter((line) => line.trim().length > 0);
---

<section class={`landing-overview-panel ${locale === 'en' ? 'landing-overview-panel--en' : ''}`} data-overview-panel>
  <div class="landing-overview-panel__inner" data-overview-panel-inner>
    <div class="landing-overview-panel__text-col">
      <span class="landing-overview-panel__label">{label}</span>
      <div class="landing-overview-panel__divider" data-overview-divider aria-hidden="true"></div>
      <div class="landing-overview-panel__content">
        {lines.map((line) => (
          <p
            class="landing-overview-panel__line"
            data-overview-line
          >
            {line}
          </p>
        ))}
      </div>
    </div>
    <HomeMonolithVisual />
  </div>
</section>

<style>
  .landing-overview-panel {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: clamp(3rem, 8vh, 5rem) clamp(1.2rem, 4vw, 3rem);
    background: var(--color-background);
    color: var(--color-secondary-foreground);
    overflow: hidden;
  }

  .landing-overview-panel__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(90rem, 100%);
    display: grid;
    grid-template-columns: 1fr clamp(14rem, 22vw, 22rem);
    align-items: start;
    gap: clamp(2.5rem, 5vw, 6rem);
    padding-left: clamp(1.5rem, 3.2vw, 3.125rem);
  }

  .landing-overview-panel__text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .landing-overview-panel__label {
    margin-bottom: 0.8rem;
    font-family: 'POIRETONE-REGULAR', 'Hiragino Sans GB', 'Noto Sans SC', sans-serif;
    font-size: clamp(0.82rem, 1.1vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.75;
    line-height: 1;
  }

  .landing-overview-panel__divider {
    width: min(10rem, 26vw);
    height: 1px;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    background: color-mix(in srgb, var(--color-border-inverse-strong) 72%, transparent);
    transform-origin: left center;
    transform: scaleX(0);
    /* GSAP drives the scaleX reveal */
  }

  .landing-overview-panel__content {
    position: relative;
    display: block;
  }

  .landing-overview-panel__line {
    margin: 0 0 1.4rem;
    font-family: 'Hiragino Sans GB', 'Noto Sans SC', 'PingFang SC', 'POIRETONE-REGULAR', 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.82;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-secondary-foreground) 84%, transparent);
    -webkit-font-smoothing: antialiased;
    /* Text starts empty; GSAP typewriter fills it char-by-char */
  }

  .landing-overview-panel__line:last-child {
    margin-bottom: 0;
  }

  .landing-overview-panel--en .landing-overview-panel__line {
    font-size: clamp(1.3rem, 1vw + 0.92rem, 1.8rem);
  }

  .landing-overview-panel:not(.landing-overview-panel--en) .landing-overview-panel__line {
    font-size: clamp(1.4rem, 1.1vw + 1rem, 1.96rem);
  }

  :lang(zh) .landing-overview-panel__line {
    line-height: 1.96;
    letter-spacing: 0.06em;
  }


  @media (max-width: 720px) {
    .landing-overview-panel {
      padding-top: max(4.75rem, calc(env(safe-area-inset-top) + 4rem));
      padding-inline: max(1rem, calc(env(safe-area-inset-left) + 0.9rem))
        max(1rem, calc(env(safe-area-inset-right) + 0.9rem));
      padding-bottom: max(3rem, calc(env(safe-area-inset-bottom) + 2.4rem));
    }

    .landing-overview-panel__inner {
      padding-left: 0;
    }

    .landing-overview-panel__inner {
      max-width: 100%;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .landing-overview-panel__label {
      font-size: 0.66rem;
    }

    .landing-overview-panel--en .landing-overview-panel__line,
    .landing-overview-panel:not(.landing-overview-panel--en) .landing-overview-panel__line {
      font-size: clamp(1.1rem, 4.6vw, 1.36rem);
    }

    :global(.landing-second-panel__visual-column) {
      justify-content: center;
      padding-right: 0;
    }

    :global(.landing-second-panel__visual-shell) {
      width: min(48vw, 13rem);
    }
  }
</style>
