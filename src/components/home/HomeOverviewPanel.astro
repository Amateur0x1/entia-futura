---
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  label: string;
  /** Paragraphs separated by '\n'. First is primary, the rest secondary. */
  body: string;
}

const { locale, label, body } = Astro.props;
const lines = body.split('\n').filter((line) => line.trim().length > 0);
---

<section class={`landing-overview-panel ${locale === 'en' ? 'landing-overview-panel--en' : ''}`} data-overview-panel>
  <canvas class="landing-overview-panel__nebula" data-nebula-canvas aria-hidden="true"></canvas>
  <!-- Diagonal atmosphere veil: top-left cyan, bottom-right violet -->
  <div class="landing-overview-panel__veil" aria-hidden="true"></div>
  <div class="landing-overview-panel__inner" data-overview-panel-inner>
    <span class="landing-overview-panel__label">{label}</span>
    <div class="landing-overview-panel__divider" data-overview-divider aria-hidden="true"></div>
    <div class="landing-overview-panel__content">
      {lines.map((line) => (
        <p
          class="landing-overview-panel__line"
          data-overview-line
        >
          {line}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  .landing-overview-panel {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 10vh, 7rem) clamp(1.5rem, 8vw, 8rem);
    background: var(--color-background);
    color: var(--color-secondary-foreground);
    /* Initial hidden state is driven by GSAP (opacity:0, yPercent:100 via transform) */
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: 0;
  }

  .landing-overview-panel__nebula {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.76;
  }

  /* ── Diagonal atmosphere veil: top-left cyan, bottom-right violet ── */
  .landing-overview-panel__veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 90% 90% at -10% -10%,
        color-mix(in srgb, var(--color-primary) 22%, transparent) 0%,
        color-mix(in srgb, var(--color-primary) 7%, transparent) 50%,
        transparent 78%
      ),
      radial-gradient(
        ellipse 90% 90% at 110% 110%,
        color-mix(in srgb, var(--color-secondary) 22%, transparent) 0%,
        color-mix(in srgb, var(--color-secondary) 7%, transparent) 50%,
        transparent 78%
      );
  }

  .landing-overview-panel__inner {
    position: relative;
    z-index: 1;
    max-width: min(54rem, 80vw);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .landing-overview-panel__label {
    margin-bottom: 0.6rem;
    font-family: 'POIRETONE-REGULAR', 'Hiragino Sans GB', 'Noto Sans SC', sans-serif;
    font-size: clamp(0.64rem, 0.9vw, 0.82rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.75;
    line-height: 1;
  }

  .landing-overview-panel__divider {
    width: min(8rem, 22vw);
    height: 1px;
    margin-top: 0.4rem;
    margin-bottom: 1.8rem;
    background: color-mix(in srgb, var(--color-border-inverse-strong) 72%, transparent);
    transform-origin: center center;
    transform: scaleX(0);
    /* GSAP drives the scaleX reveal */
  }

  .landing-overview-panel__content {
    position: relative;
    display: block;
  }

  .landing-overview-panel__line {
    margin: 0 0 1.2rem;
    font-family: 'Hiragino Sans GB', 'Noto Sans SC', 'PingFang SC', 'POIRETONE-REGULAR', 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.74;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-secondary-foreground) 82%, transparent);
    -webkit-font-smoothing: antialiased;
    opacity: 0;
    /* GSAP drives fade-in per line */
  }

  .landing-overview-panel__line:last-child {
    margin-bottom: 0;
  }

  .landing-overview-panel--en .landing-overview-panel__line {
    font-size: clamp(1.04rem, 1.5vw, 1.32rem);
  }

  .landing-overview-panel:not(.landing-overview-panel--en) .landing-overview-panel__line {
    font-size: clamp(1.08rem, 1.62vw, 1.38rem);
  }

  :lang(zh) .landing-overview-panel__line {
    line-height: 1.92;
    letter-spacing: 0.05em;
  }


  @media (max-width: 720px) {
    .landing-overview-panel {
      padding: max(4rem, calc(env(safe-area-inset-top) + 3rem))
        max(1.2rem, calc(env(safe-area-inset-left) + 1rem))
        max(3rem, calc(env(safe-area-inset-bottom) + 2.4rem));
    }

    .landing-overview-panel__veil {
      display: none;
    }

    .landing-overview-panel__inner {
      max-width: 100%;
    }

    .landing-overview-panel__label {
      font-size: 0.66rem;
    }

    .landing-overview-panel--en .landing-overview-panel__line,
    .landing-overview-panel:not(.landing-overview-panel--en) .landing-overview-panel__line {
      font-size: clamp(1rem, 4.2vw, 1.2rem);
    }
  }
</style>
