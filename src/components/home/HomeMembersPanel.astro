---
import { pickByLocale, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Flair images — shared pool of shaped photos for cursor trail.
// All members use the same set; different shapes add visual variety.
const flairImages = [
  '/images/flair/m1-circle.png',    // circle
  '/images/flair/m1-diamond.png',   // diamond
  '/images/flair/m1-roundsq.png',   // rounded square
  '/images/flair/m2-hexagon.png',   // hexagon
  '/images/flair/m2-smcircle.png',  // small circle
  '/images/flair/m2-ellipse.png',   // ellipse
  '/images/flair/m3-softsq.png',    // soft square
  '/images/flair/m3-triangle.png',  // triangle
  '/images/flair/m3-octagon.png',   // octagon
];

const members = [
  {
    src: '/images/members/member-02.jpg',
    name: pickByLocale(locale, '马城', 'Cheng Ma'),
    role: pickByLocale(locale, '人类学博士', 'PhD in Anthropology'),
    bio: pickByLocale(
      locale,
      '柏林自由大学人类学博士研究生，关注未来机构形态、知识生产与社会创新，致力于在大学之外建立新的研究基础设施。',
      'Cheng Ma is an anthropologist, curator, and interdisciplinary researcher. Currently pursuing a PhD in Anthropology at Free University of Berlin, his research focuses on entrepreneurship, intellectual networks, and social change. As the founder of Entia Futura, he is interested in building bridges between knowledge and practice.',
    ),
  },
  {
    src: '/images/members/member-01.jpg',
    name: pickByLocale(locale, 'Dreamer Piggy', 'Dreamer Piggy'),
    role: pickByLocale(locale, '独立开发者', 'Indie Developer'),
    bio: pickByLocale(
      locale,
      '独立开发者，大厂螺丝工，INTP。作品：煮理人 App。热爱各种创作，分享做产品与学习的过程和感悟，提供有趣的产品给到大家。',
      'Independent developer and creator. Builder of Zhuliren App. Passionate about all forms of creation, sharing the journey of building products and learning, bringing interesting products to everyone.',
    ),
  },
  {
    src: '/images/members/member-03.jpg',
    name: pickByLocale(locale, '汪季宸', 'Jichen Wang'),
    role: pickByLocale(locale, '独立书店主理人', 'Independent Bookstore Owner'),
    bio: pickByLocale(
      locale,
      '华东师范大学外国哲学硕士，政治哲学方向，研究兴趣在德国观念论、政治现象学；现居景德镇，创立并运营一家独立书店。',
      'MA in Foreign Philosophy from East China Normal University, specializing in political philosophy with research interests in German Idealism and political phenomenology. Currently based in Jingdezhen, where he founded and runs an independent bookstore.',
    ),
  },
];

// Gradient border colours per card (cyan, violet, mixed)
const borderGradients = [
  'linear-gradient(135deg, #00e5ff, #007a8a, #00e5ff)',
  'linear-gradient(135deg, #7b5cff, #c850c0, #7b5cff)',
  'linear-gradient(135deg, #00e5ff, #7b5cff, #00e5ff)',
];
---

<section class="members-panel" data-members-panel>
  <div class="members-sticky">
    <!-- Flair cursor trail — shared pool of shaped images (outside .members-content to avoid transform breaking position:fixed) -->
    <div class="members-flair-container" data-members-flair>
      {flairImages.map((src, i) => (
        <img
          class="members-flair-img"
          src={src}
          alt=""
          loading="eager"
          draggable="false"
          data-flair-img
          data-flair-idx={i}
        />
      ))}
    </div>

    <div class="members-content">
      <!-- Left: stacked card deck -->
      <div class="members-deck" data-members-deck>
        {members.map((m, i) => (
          <div
            class={`members-deck__card ${i === members.length - 1 ? 'members-deck__card--front' : ''}`}
            data-members-flip-card
            data-member-index={i}
          >
            <div class="members-deck__border" style={`background: ${borderGradients[i]}`}>
              <img
                class="members-deck__img"
                src={m.src}
                alt={m.name}
                loading="lazy"
                draggable="false"
              />
            </div>
          </div>
        ))}
      </div>

      <!-- Right: member info that syncs with cards -->
      <div class="members-info" data-members-info>
        {members.map((m, i) => (
          <div
            class={`members-info__item ${i === 0 ? 'members-info__item--active' : ''}`}
            data-members-info-item
            data-member-index={i}
          >
            <h3 class="members-info__name">{m.name}</h3>
            <span class="members-info__role">{m.role}</span>
            <p class="members-info__bio">{m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .members-panel {
    position: relative;
    z-index: 38;
    background: var(--color-background);
  }

  .members-sticky {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  /* ── Two-column layout ── */
  .members-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: clamp(3rem, 6vw, 8rem);
    width: min(88vw, 64rem);
  }

  /* ── Left: Card deck ── */
  .members-deck {
    position: relative;
    flex-shrink: 0;
    width: clamp(16rem, 22vw, 26rem);
    aspect-ratio: 3 / 4;
  }

  .members-deck__card {
    position: absolute;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 1rem;
    overflow: hidden;
    will-change: transform, opacity;
    cursor: default;
    pointer-events: none;
  }

  /* Stacking offsets are controlled by JS (initMembersCarousel) */

  .members-deck__border {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    padding: 3px;
  }

  .members-deck__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(1rem - 3px);
    background: var(--color-background);
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Right: Member info ── */
  .members-info {
    position: relative;
    flex: 1;
    min-height: 14rem;
  }

  .members-info__item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: none; /* GSAP controls transitions */
  }

  .members-info__item--active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .members-info__name {
    margin: 0 0 0.6rem;
    font-family: 'POIRETONE-REGULAR', 'Hiragino Sans GB', 'Noto Sans SC', sans-serif;
    font-size: clamp(1.4rem, 1.8vw + 0.4rem, 2.2rem);
    font-weight: normal;
    letter-spacing: 0.06em;
    color: var(--color-secondary-foreground);
    line-height: 1.3;
  }

  .members-info__role {
    display: block;
    margin-bottom: 1.2rem;
    font-family: 'POIRETONE-REGULAR', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(0.6rem, 0.5vw + 0.36rem, 0.76rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.7;
  }

  .members-info__bio {
    margin: 0;
    font-size: clamp(1.05rem, 0.7vw + 0.7rem, 1.32rem);
    line-height: 1.85;
    color: color-mix(in srgb, var(--color-secondary-foreground) 60%, transparent);
    max-width: 28rem;
  }
  /* ── Flair cursor follower ── */
  :global(.members-flair-container) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    overflow: hidden;
  }

  :global(.members-flair-img) {
    position: fixed;
    opacity: 0;
    width: 90px;
    pointer-events: none;
    z-index: 51;
  }

  /* ── Mobile: stack vertically ── */
  @media (max-width: 720px) {
    .members-content {
      flex-direction: column;
      gap: 2.5rem;
      width: min(92vw, 24rem);
    }

    .members-deck {
      width: clamp(12rem, 55vw, 16rem);
    }

    .members-info {
      text-align: center;
      min-height: 12rem;
    }

    .members-info__bio {
      max-width: none;
    }

    :global(.members-flair-container) {
      display: none;
    }
  }
</style>
