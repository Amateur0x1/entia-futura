---
import { type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = locale === 'zh'
  ? [
      'AI 与未来生活',
      '知识生产\n与新型学习共同体',
      '社群、空间\n与新的公共生活',
      '地方文化\n与未来组织形式',
      '商业世界\n中的研究能力',
      '未来共同体\n与生活形式实验',
    ]
  : [
      'AI and\nFuture Life',
      'Knowledge Production\nand New Learning Communities',
      'Communities, Space,\nand New Public Life',
      'Local Culture and\nFuture Forms of Organization',
      'Research Capacity\nin the Commercial World',
      'Experimenting with\nFuture Forms of Collective Life',
    ];
---

<!-- Loading backdrop: logo + orbiting texts, visible only during loading -->
<div class="loading-orbit-device" id="loading-orbit-device" aria-hidden="true">
  <!-- Nebula particle background -->
  <canvas class="loading-orbit-device__nebula" id="loading-nebula-canvas" aria-hidden="true"></canvas>

  <!-- Atmosphere veil -->
  <div class="loading-orbit-device__veil" aria-hidden="true"></div>

  <!-- Central logo -->
  <div class="loading-orbit-device__logo-wrap">
    <img
      class="loading-orbit-device__logo"
      src="/brand/entia-logo-white-lines.png"
      alt=""
      draggable="false"
    />
  </div>

  <!-- Orbit items -->
  <div class="loading-orbit-device__orbit" data-loading-orbit>
    {items.map((item, i) => (
      <div class="loading-orbit-device__orbit-item" data-loading-orbit-item data-index={i}>
        <span class="loading-orbit-device__orbit-dot" aria-hidden="true"></span>
        <span class="loading-orbit-device__orbit-text" set:html={item.replace(/\n/g, '<br>')} />
      </div>
    ))}
  </div>
</div>

<style>
  .loading-orbit-device {
    position: fixed;
    inset: 0;
    z-index: 9990; /* below PageLoader (9999) but above everything else */
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    background: var(--color-background);
    transition: opacity 0.72s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.72s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .loading-orbit-device.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  /* ── Nebula canvas ── */
  .loading-orbit-device__nebula {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.88;
  }

  /* ── Atmosphere veil ── */
  .loading-orbit-device__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 90% 90% at -10% -10%,
        color-mix(in srgb, var(--color-primary) 18%, transparent) 0%,
        color-mix(in srgb, var(--color-primary) 6%, transparent) 50%,
        transparent 78%
      ),
      radial-gradient(
        ellipse 90% 90% at 110% 110%,
        color-mix(in srgb, var(--color-secondary) 18%, transparent) 0%,
        color-mix(in srgb, var(--color-secondary) 6%, transparent) 50%,
        transparent 78%
      );
  }

  /* ── Logo ── */
  .loading-orbit-device__logo-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    pointer-events: none;
    width: clamp(260px, 34vmin, 480px);
    height: clamp(260px, 34vmin, 480px);
  }

  .loading-orbit-device__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.88;
    filter: drop-shadow(0 0 32px color-mix(in srgb, var(--color-primary) 36%, transparent));
  }

  /* ── Orbit container ── */
  .loading-orbit-device__orbit {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  /* ── Individual orbit item ── */
  .loading-orbit-device__orbit-item {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
    top: 50%;
    left: 50%;
    z-index: 6;
  }

  .loading-orbit-device__orbit-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px 1px var(--color-primary),
      0 0 16px 2px color-mix(in srgb, var(--color-primary) 70%, transparent),
      0 0 1px #fff;
    opacity: 1;
  }

  .loading-orbit-device__orbit-text {
    font-family: 'POIRETONE-REGULAR', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(0.75rem, 0.7vw + 0.52rem, 1.05rem);
    letter-spacing: 0.06em;
    line-height: 1.45;
    color: #b9cad0;
    white-space: pre-line;
    text-shadow: 0 0 12px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }
</style>

<script>
  (() => {
    const device = document.getElementById('loading-orbit-device');
    const orbitEls = Array.from(document.querySelectorAll<HTMLElement>('[data-loading-orbit-item]'));
    if (!device || orbitEls.length === 0) return;

    // ══════════════════════════════════════════════════════════════════════════
    // Nebula particle background (inlined from initThirdPanelNebulaBackground)
    // ══════════════════════════════════════════════════════════════════════════
    const nebulaCanvas = document.getElementById('loading-nebula-canvas') as HTMLCanvasElement | null;
    if (nebulaCanvas) {
      const nCtx = nebulaCanvas.getContext('2d');
      if (nCtx) {
        const PARTICLE_MARGIN = 48;
        const TARGET_DENSITY = 600;
        const TRAIL_ALPHA = 0.11;
        const ANCHOR_X_MIN = 72;
        const ANCHOR_X_MAX = 180;
        const ANCHOR_X_RATIO = 0.12;
        const ANCHOR_Y_MIN = 64;
        const ANCHOR_Y_MAX = 150;
        const ANCHOR_Y_RATIO = 0.14;
        const nebulaTheme = ['#8ff2ff', '#6dd4ff', '#6a8dff', '#f4fcff'];

        interface NParticle {
          x: number; y: number; vx: number; vy: number;
          life: number; decay: number; size: number; color: string;
        }

        let nW = 0, nH = 0;
        let nebulaRaf = 0;
        let nParticles: NParticle[] = [];

        const getRandomColor = () => nebulaTheme[Math.floor(Math.random() * nebulaTheme.length)] ?? nebulaTheme[0];

        const buildParticle = (w: number, h: number): NParticle => ({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          life: 1,
          decay: 1 / (Math.random() * 90 + 70),
          size: Math.random() * 2 + 0.4,
          color: getRandomColor(),
        });

        const nebulaResize = () => {
          const bounds = device!.getBoundingClientRect();
          nW = Math.max(1, Math.floor(bounds.width));
          nH = Math.max(1, Math.floor(bounds.height));
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          nebulaCanvas.width = Math.floor(nW * dpr);
          nebulaCanvas.height = Math.floor(nH * dpr);
          nCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
          while (nParticles.length < TARGET_DENSITY) {
            nParticles.push(buildParticle(nW, nH));
          }
          nParticles.length = TARGET_DENSITY;
        };

        const getAnchorPoint = () => ({
          x: Math.min(ANCHOR_X_MAX, Math.max(ANCHOR_X_MIN, nW * ANCHOR_X_RATIO)),
          y: Math.min(ANCHOR_Y_MAX, Math.max(ANCHOR_Y_MIN, nH * ANCHOR_Y_RATIO)),
        });

        const updateParticle = (p: NParticle) => {
          const anchor = getAnchorPoint();
          const dx = anchor.x - p.x;
          const dy = anchor.y - p.y;
          const dist = Math.hypot(dx, dy) + 1;
          const force = Math.min(140 / dist, 1.8);
          p.vx += (-dy / dist) * force * 0.07;
          p.vy += (dx / dist) * force * 0.07;
          p.vx *= 0.95;
          p.vy *= 0.95;
          p.x += p.vx;
          p.y += p.vy;
          p.life -= p.decay;
          const oob = p.x < -PARTICLE_MARGIN || p.x > nW + PARTICLE_MARGIN ||
                      p.y < -PARTICLE_MARGIN || p.y > nH + PARTICLE_MARGIN;
          if (p.life <= 0 || oob) Object.assign(p, buildParticle(nW, nH));
        };

        const drawConnections = () => {
          if (nParticles.length > 340) return;
          nCtx.lineWidth = 0.55;
          nCtx.strokeStyle = 'rgba(137, 235, 255, 0.45)';
          for (let i = 0; i < nParticles.length; i += 2) {
            for (let j = i + 2; j < nParticles.length; j += 5) {
              const a = nParticles[i], b = nParticles[j];
              if (!a || !b) continue;
              const dx = a.x - b.x, dy = a.y - b.y;
              const d2 = dx * dx + dy * dy;
              if (d2 > 5400) continue;
              nCtx.globalAlpha = (1 - Math.sqrt(d2) / 74) * 0.24 * Math.min(a.life, b.life);
              nCtx.beginPath();
              nCtx.moveTo(a.x, a.y);
              nCtx.lineTo(b.x, b.y);
              nCtx.stroke();
            }
          }
        };

        const nebulaFrame = () => {
          nCtx.fillStyle = `rgba(5, 7, 11, ${TRAIL_ALPHA})`;
          nCtx.fillRect(0, 0, nW, nH);
          nCtx.globalCompositeOperation = 'lighter';
          for (const p of nParticles) {
            updateParticle(p);
            nCtx.globalAlpha = p.life * 0.9;
            nCtx.fillStyle = p.color;
            nCtx.beginPath();
            nCtx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
            nCtx.fill();
          }
          nCtx.globalCompositeOperation = 'source-over';
          nCtx.globalAlpha = 1;
          drawConnections();
          nebulaRaf = window.requestAnimationFrame(nebulaFrame);
        };

        nebulaResize();
        nParticles = Array.from({ length: TARGET_DENSITY }, () => buildParticle(nW, nH));
        nebulaFrame();
        window.addEventListener('resize', nebulaResize);

        // Stop nebula on loader:done
        document.addEventListener('loader:done', () => {
          window.cancelAnimationFrame(nebulaRaf);
        }, { once: true });
      }
    }
    // ══════════════════════════════════════════════════════════════════════════

    // ── Config ──────────────────────────────────────────────────────────────
    const REPULSE_RADIUS   = 100;
    const REPULSE_STRENGTH = 0.42;
    const SPRING           = 0.07;
    const DAMPING          = 0.80;
    const ORBIT_RADIUS_SCALE = 0.09;
    const SPIN_SPEED       = 0.000050; // rad/ms

    // Staggered fade-in: 5s total, each item fades in over 1s
    const FADE_IN_TOTAL    = 5000;
    const FADE_IN_EACH     = 1000;
    const COUNT            = orbitEls.length;
    const STAGGER_DELAY    = (FADE_IN_TOTAL - FADE_IN_EACH) / Math.max(COUNT - 1, 1);

    // ── Per-item state ───────────────────────────────────────────────────────
    interface Item {
      el: HTMLElement;
      baseAngle: number;
      orbitR: number;
      x: number; y: number;
      vx: number; vy: number;
      hw: number; hh: number;
      fadeStart: number; // ms offset when this item starts fading in
    }

    let W = 0, H = 0;
    let mouseX = -9999, mouseY = -9999;
    let items: Item[] = [];
    let startTime = 0;
    let raf = 0;
    let active = true;

    // ── Build item state ─────────────────────────────────────────────────────
    function build() {
      const logoR  = Math.min(W, H) * 0.16;
      const orbitR = Math.min(W, H) * ORBIT_RADIUS_SCALE + logoR;
      const cx = W / 2, cy = H / 2;

      items = orbitEls.map((el, i) => {
        const baseAngle = (i / COUNT) * Math.PI * 2 - Math.PI / 2;
        const px = cx + Math.cos(baseAngle) * orbitR;
        const py = cy + Math.sin(baseAngle) * orbitR;
        const rect = el.getBoundingClientRect();
        return {
          el,
          baseAngle,
          orbitR,
          x: px, y: py,
          vx: 0, vy: 0,
          hw: rect.width  / 2,
          hh: rect.height / 2,
          fadeStart: i * STAGGER_DELAY,
        };
      });
    }

    // ── Resize ───────────────────────────────────────────────────────────────
    function resize() {
      W = device!.offsetWidth;
      H = device!.offsetHeight;
      build();
    }

    // ── Draw loop ────────────────────────────────────────────────────────────
    function draw(ts: number) {
      if (!startTime) startTime = ts;
      const elapsed = ts - startTime;
      const spinAngle = elapsed * SPIN_SPEED;
      const cx = W / 2, cy = H / 2;

      for (const it of items) {
        // Staggered fade: each item starts at its own delay
        const itemElapsed = elapsed - it.fadeStart;
        const fadeProgress = Math.max(0, Math.min(itemElapsed / FADE_IN_EACH, 1));

        // Rotating origin
        const rotAngle = it.baseAngle + spinAngle;
        const ox = cx + Math.cos(rotAngle) * it.orbitR;
        const oy = cy + Math.sin(rotAngle) * it.orbitR;

        // Mouse repulsion
        const dx = mouseX - it.x;
        const dy = mouseY - it.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < REPULSE_RADIUS && dist > 0) {
          const force = (1 - dist / REPULSE_RADIUS) * REPULSE_STRENGTH;
          it.vx -= (dx / dist) * force * 14;
          it.vy -= (dy / dist) * force * 14;
        }

        // Spring back
        it.vx += (ox - it.x) * SPRING;
        it.vy += (oy - it.y) * SPRING;
        it.vx *= DAMPING;
        it.vy *= DAMPING;
        it.x += it.vx;
        it.y += it.vy;

        // Apply transform
        it.el.style.transform = `translate(calc(${it.x - W / 2}px - 50%), calc(${it.y - H / 2}px - 50%))`;
        it.el.style.opacity = String(fadeProgress);
      }

      if (active) raf = requestAnimationFrame(draw);
    }

    // ── Mouse ────────────────────────────────────────────────────────────────
    function onMouseMove(e: MouseEvent) {
      const r = device!.getBoundingClientRect();
      mouseX = e.clientX - r.left;
      mouseY = e.clientY - r.top;
    }
    function onPointerLeave() { mouseX = -9999; mouseY = -9999; }

    // ── Start animation immediately ──────────────────────────────────────────
    resize();
    new ResizeObserver(resize).observe(device);
    document.addEventListener('mousemove', onMouseMove, { passive: true });
    device.addEventListener('mouseleave', onPointerLeave, { passive: true });
    raf = requestAnimationFrame(draw);

    // ── Hide on loader:done ──────────────────────────────────────────────────
    document.addEventListener('loader:done', () => {
      active = false;
      cancelAnimationFrame(raf);
      device.classList.add('is-hidden');
    }, { once: true });
  })();
</script>
